{
  "name": "price-pump",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-conscious nearby gas price comparison app.",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev:background": "node scripts/dev-background.mjs start",
    "dev:status": "node scripts/dev-background.mjs status",
    "dev:stop": "node scripts/dev-background.mjs stop",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
